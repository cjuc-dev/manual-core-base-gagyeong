                    html += '            </div>';
                }

                html += '        </div>';
                html += '    </div>';
                html += '</details>';
            });
        }
        html += '</div>';
        
        contentArea.innerHTML = html;
        lucide.createIcons();
    } catch (e) {
        console.error("Error in renderVocList:", e);
        contentArea.innerHTML = '<p class="text-center text-red-500 py-8">데이터를 불러오는 중 오류가 발생했습니다.<br>' + e.message + '</p>';
    }
}

function toggleVocContent(id) {
    const content = document.getElementById('voc-content-' + id);
    const icon = document.getElementById('voc-icon-' + id);
    
    content.classList.toggle('hidden');
    if (content.classList.contains('hidden')) {
        icon.classList.remove('rotate-180');
    } else {
        icon.classList.add('rotate-180');
    }
}

// --- VOC WRITE MODAL ---
const vocWriteModal = document.getElementById('vocWriteModal');
const vocTitle = document.getElementById('vocTitle');
const vocAuthor = document.getElementById('vocAuthor');
const vocContent = document.getElementById('vocContent');
const vocAnswer = document.getElementById('vocAnswer');
const vocCategoryInput = document.getElementById('vocCategory');
const vocIdInput = document.getElementById('vocId');
const vocFirestoreIdInput = document.getElementById('vocFirestoreId');

function tryOpenVocWriteModal(category) {
    if (window.isAdminAuthenticated) {
        window.openVocWriteModal(category);
    } else {
        window.pendingAction = 'voc_write';
        window.pendingCategory = category;
        window.showAdminAuthModal();
    }
}

function openVocWriteModal(category) {
    vocTitle.value = '';
    vocAuthor.value = '익명';
    vocContent.value = '';
    vocAnswer.value = '';
    vocCategoryInput.value = category;
    vocIdInput.value = '';
    vocFirestoreIdInput.value = '';
    
    vocWriteModal.classList.remove('hidden');
}

function openVocEditModal(firestoreId, category) {
    // Load item
    loadVocList(category).then(list => {
        const item = list.find(i => i.firestoreId === firestoreId || i.id == firestoreId);
        if (item) {
            vocTitle.value = item.title;
            vocAuthor.value = item.author;
            vocContent.value = item.content;
            vocAnswer.value = item.answer || '';
            vocCategoryInput.value = category; // Keep category
            vocIdInput.value = item.id || ''; // Legacy ID
            vocFirestoreIdInput.value = item.firestoreId || '';
            
            vocWriteModal.classList.remove('hidden');
        }
    });
}

function tryEditVoc(firestoreId, category) {
    if (window.isAdminAuthenticated) {
        openVocEditModal(firestoreId, category);
    } else {
        window.pendingAction = 'voc_edit';
        window.pendingTargetId = firestoreId;
        window.pendingCategory = category;
        window.showAdminAuthModal();
    }
}

function deleteVoc(firestoreId, category) {
    if (window.isAdminAuthenticated) {
        window.showConfirmModal('정말로 삭제하시겠습니까?', async () => {
            try {
                const collectionName = getCollectionName(category);
                if (window.db && typeof firestoreId === 'string') { // Only check for window.db
                    // Compat: db.collection().doc().delete()
                    await window.db.collection(collectionName).doc(firestoreId).delete();
                    console.log("Deleted from Firestore collection:", collectionName);
                } else {
                    // Legacy delete
                    const list = await loadVocList(category);
                    const newList = list.filter(i => i.id != firestoreId);
                    saveVocList(newList);
                }
                
                renderVocList(category);
                
                // Feedback
                const successMsg = document.createElement('div');
                successMsg.className = 'fixed bottom-4 right-4 bg-red-600 text-white px-6 py-3 rounded-lg shadow-lg z-50 animate-fade-in-up';
                successMsg.innerHTML = '<i data-lucide="check-circle" class="w-5 h-5 inline mr-2"></i> 삭제 완료';
                document.body.appendChild(successMsg);
                lucide.createIcons();
                setTimeout(() => successMsg.remove(), 2000);
                
            } catch (e) {
                console.error("Delete failed:", e);
                alert("삭제 실패: " + e.message);
            }
        });
    } else {
        window.pendingAction = 'voc_delete';
        window.pendingTargetId = firestoreId;
        window.pendingCategory = category;
        window.showAdminAuthModal();
    }
}

function closeVocWriteModal() {
    vocWriteModal.classList.add('hidden');
}

async function saveVoc() {
    const title = vocTitle.value;
    const author = vocAuthor.value;
    const content = vocContent.value;
    const answer = vocAnswer.value;
    const category = vocCategoryInput.value;
    const id = vocIdInput.value;
    const firestoreId = vocFirestoreIdInput.value;

    if (!title || !content) {
        alert('제목과 내용을 입력해주세요.');
        return;
    }

    // Visual Feedback
    const saveBtn = document.querySelector('#vocWriteModal button[onclick="saveVoc()"]');
    const originalBtnText = saveBtn ? saveBtn.innerText : '저장';
    if (saveBtn) {
        saveBtn.innerText = '저장 중...';
        saveBtn.disabled = true;
    }

    const now = new Date();
    const dateStr = now.getFullYear() + '-' + 
                    String(now.getMonth() + 1).padStart(2, '0') + '-' + 
                    String(now.getDate()).padStart(2, '0');

    try {
        if (window.db) { // Only check for window.db
            console.log("Starting Firestore save...");
            const collectionName = getCollectionName(category);
            
            // Firestore Save (Compat)
            if (firestoreId) {
                console.log("Updating existing doc:", firestoreId, "in", collectionName);
                // Compat: db.collection().doc().update()
                await withTimeout(window.db.collection(collectionName).doc(firestoreId).update({
                    title: title,
                    author: author,
                    content: content,
                    answer: answer,
                }));
            } else {
                console.log("Adding new doc to", collectionName);
                // Compat: db.collection().add()
                const newId = Date.now(); 
                
                await withTimeout(window.db.collection(collectionName).add({
                    id: newId,
                    title: title,
                    author: author,
                    date: dateStr,
                    content: content,
                    answer: answer,
                    category: category
                }));
            }
            console.log("Firestore save complete");
        } else {
            console.warn("Firebase globals missing, falling back to local storage");
            // Legacy LocalStorage Save
            const list = await loadVocList(category);
            if (id || firestoreId) { // Edit
                const targetId = firestoreId || id;
                const index = list.findIndex(i => (i.firestoreId === targetId) || (i.id == targetId));
                if (index !== -1) {
                    list[index].title = title;
                    list[index].author = author;
                    list[index].content = content;
                    list[index].answer = answer;
                }
            } else { // New
                const newId = list.length > 0 ? Math.max(...list.map(i => i.id)) + 1 : 1;
                list.push({
                    id: newId,
                    title: title,
                    author: author,
                    date: dateStr,
                    content: content,
                    answer: answer,
                    category: category
                });
            }
            saveVocList(list);
        }
        
        closeVocWriteModal();
        renderVocList(category);

    } catch (e) {
        console.error("Firestore Save failed:", e);
        
        // Fallback to LocalStorage
        try {
            console.log("Falling back to LocalStorage...");
            const list = await loadVocList(category);
            
            // Generate ID if needed
            const newId = id || Date.now();
            
            const newItem = {
                id: newId,
                title: title,
                author: author,
                date: dateStr,
                content: content,
                answer: answer,
                category: category,
                firestoreId: firestoreId || null // Keep track if it had one
            };

            if (id || firestoreId) {
                // Edit
                const targetId = firestoreId || id;
                const index = list.findIndex(i => (i.firestoreId === targetId) || (i.id == targetId));
                if (index !== -1) {
                    list[index] = { ...list[index], ...newItem };
                } else {
                    list.push(newItem);
                }
            } else {
                // New
                list.push(newItem);
            }
            
            saveVocList(list);
            alert("⚠️ Firebase 연결에 실패하여 '로컬 저장소'에 저장되었습니다.\n(인터넷 연결이나 방화벽 설정을 확인해주세요.)");
            
            closeVocWriteModal();
            renderVocList(category);
            
        } catch (localError) {
            console.error("Local Save failed:", localError);
            alert("저장 실패 (로컬 저장소 오류): " + localError.message);
        }
    } finally {
        if (saveBtn) {
            saveBtn.innerText = originalBtnText;
            saveBtn.disabled = false;
        }
    }
}

// Helper for timeout
function withTimeout(promise, ms = 5000) {
    return Promise.race([
        promise,
        new Promise((_, reject) => setTimeout(() => reject(new Error("Request timed out (5s)")), ms))
    ]);
}

// Make functions globally available
window.loadVocList = loadVocList;
window.renderVocList = renderVocList;
window.toggleVocContent = toggleVocContent;
window.tryOpenVocWriteModal = tryOpenVocWriteModal;
window.openVocWriteModal = openVocWriteModal;
window.openVocEditModal = openVocEditModal;
window.tryEditVoc = tryEditVoc;
window.deleteVoc = deleteVoc;
window.closeVocWriteModal = closeVocWriteModal;
window.saveVoc = saveVoc;
