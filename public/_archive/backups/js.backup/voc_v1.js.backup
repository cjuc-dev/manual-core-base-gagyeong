                adminButtons += '<button onclick="deleteVoc(' + deleteId + ', \'' + category + '\')" class="p-2 text-gray-400 hover:text-red-400 transition-colors" title="삭제">';
                adminButtons += '    <i data-lucide="trash-2" class="w-4 h-4"></i>';
