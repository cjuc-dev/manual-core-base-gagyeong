// Helpdesk Feature Logic (System Requests)

// Timeout helper
function withTimeout(promise, ms = 5000) {
    return Promise.race([
        promise,
        new Promise((_, reject) => setTimeout(() => reject(new Error('Timeout')), ms))
    ]);
}

async function loadHelpdeskList() {
    console.log("loadHelpdeskList called");
    let list = [];
    
    // 1. Try Firebase first
    try {
        if (window.db) {
            console.log("Fetching from Firebase system_requests...");
            const querySnapshot = await withTimeout(
                window.db.collection("system_requests").orderBy("id", "desc").get()
            );
            
            querySnapshot.forEach((doc) => {
                list.push({ firestoreId: doc.id, ...doc.data() });
            });
            console.log("Firebase loaded:", list.length);
        }
    } catch (e) {
        console.error("Firebase load failed:", e);
    }
    
    // 2. Fallback to LocalStorage
    if (list.length === 0) {
        const stored = localStorage.getItem('helpdesk_data');
        if (stored) {
            list = JSON.parse(stored);
            console.log("LocalStorage loaded:", list.length);
        }
    }
    
    return list;
}

function saveHelpdeskList(list) {
    localStorage.setItem('helpdesk_data', JSON.stringify(list));
}

async function renderHelpdeskList() {
    const contentArea = document.getElementById('content-area');
    if (!contentArea) return;

    // Show loading
    contentArea.innerHTML = '<div class="flex flex-col items-center justify-center py-12 text-gray-500">' +
        '<i data-lucide="loader" class="w-8 h-8 animate-spin mb-3 text-emerald-500"></i>' +
        '<p>데이터를 불러오는 중입니다...</p>' +
        '</div>';
    if (window.lucide) window.lucide.createIcons();

    try {
        const list = await loadHelpdeskList();
        console.log("Helpdesk loaded:", list.length);

        let html = '';
        html += '<div class="flex justify-between items-center mb-6 border-b border-gray-700 pb-4">';
        html += '    <h2 class="text-2xl font-bold text-amber-400 m-0">헬프데스크 (시스템 요청)</h2>';
        html += '    <button onclick="tryOpenHelpdeskWriteModal()" class="px-4 py-2 bg-amber-600 hover:bg-amber-500 text-white rounded-lg flex items-center transition">';
        html += '        <i data-lucide="plus" class="w-4 h-4 mr-2"></i> 글쓰기';
        html += '    </button>';
        html += '</div>';
        html += '<div class="space-y-4" id="helpdeskList">';

        if (list.length === 0) {
            html += '<div class="text-center py-12 text-gray-500 bg-gray-800/50 rounded-lg border border-gray-700 border-dashed">';
            html += '    <i data-lucide="inbox" class="w-12 h-12 mx-auto mb-3 opacity-50"></i>';
            html += '    <p>등록된 요청이 없습니다.</p>';
            html += '</div>';
        } else {
            const statusMap = {
                'received': { text: '접수중', color: 'gray', bg: 'bg-gray-700' },
                'in_progress': { text: '처리중', color: 'blue', bg: 'bg-blue-900' },
                'completed': { text: '처리완료', color: 'green', bg: 'bg-green-900' }
            };
            
            const facilityMap = {
                'cheongju_pool': '청주수영장',
                'purumi_center': '푸르미스포츠센터',
                'yeoungun_center': '영운국민체육센터',
                'bokdae_center': '복대국민체육센터',
                'gagyeong_center': '가경국민체육센터'
            };

            list.forEach(item => {
                const statusInfo = statusMap[item.status] || statusMap['received'];
                const facilityName = facilityMap[item.facility] || item.facility;
                
                html += '<div class="bg-slate-800/50 p-4 rounded-lg border border-slate-700 hover:bg-slate-700/50 transition duration-150">';
                html += '    <div class="flex justify-between items-start mb-2">';
                html += '        <div class="flex-1">';
                html += '            <div class="flex items-center gap-2 mb-1">';
                html += '                <span class="text-xs px-2 py-1 rounded ' + statusInfo.bg + ' text-' + statusInfo.color + '-400">' + statusInfo.text + '</span>';
                html += '                <span class="text-xs text-gray-500">[' + facilityName + ']</span>';
                html += '            </div>';
                html += '            <h4 class="text-lg font-semibold text-white mb-1">' + (item.content.length > 50 ? item.content.substring(0, 50) + '...' : item.content) + '</h4>';
                html += '            <p class="text-sm text-gray-400">';
                html += '                <i data-lucide="user" class="w-3 h-3 inline mr-1"></i>' + item.author + ' ';
                html += '                <span class="mx-2">|</span> ';
                html += '                <i data-lucide="calendar" class="w-3 h-3 inline mr-1"></i>' + item.date;
                html += '            </p>';
                html += '        </div>';
                html += '    </div>';
                
                if (item.adminResponse) {
                    html += '    <div class="mt-3 p-3 bg-slate-900/50 rounded border-l-2 border-indigo-500">';
                    html += '        <p class="text-xs text-gray-400 mb-1">관리자 답변</p>';
                    html += '        <p class="text-sm text-gray-300">' + item.adminResponse + '</p>';
                    html += '    </div>';
                }
                
                html += '    <div class="flex justify-end space-x-2 mt-3">';
                html += '        <button onclick="tryEditHelpdesk(' + item.id + ')" class="text-xs text-indigo-400 hover:text-indigo-300 flex items-center px-2 py-1 rounded hover:bg-slate-700 transition">';
                html += '            <i data-lucide="edit-2" class="w-3 h-3 mr-1"></i> 수정';
                html += '        </button>';
                html += '        <button onclick="tryDeleteHelpdesk(' + item.id + ')" class="text-xs text-red-400 hover:text-red-300 flex items-center px-2 py-1 rounded hover:bg-slate-700 transition">';
                html += '            <i data-lucide="trash-2" class="w-3 h-3 mr-1"></i> 삭제';
                html += '        </button>';
                html += '    </div>';
                html += '</div>';
            });
        }

        html += '</div>';

        contentArea.innerHTML = html;
        if (window.lucide) window.lucide.createIcons();

    } catch (error) {
        console.error("Render error:", error);
        contentArea.innerHTML = '<div class="text-center py-12 text-red-500">오류가 발생했습니다: ' + error.message + '</div>';
    }
}

// Modal functions
function openHelpdeskWriteModal() {
    document.getElementById('helpdeskWriteModal').classList.remove('hidden');
    document.getElementById('helpdesk-id').value = '';
    document.getElementById('helpdesk-firestore-id').value = '';
    document.getElementById('helpdesk-author').value = '';
    document.getElementById('helpdesk-facility').value = '';
    document.getElementById('helpdesk-category').value = '';
    document.getElementById('helpdesk-content').value = '';
    document.getElementById('helpdesk-status').value = 'received';
    document.getElementById('helpdesk-response').value = '';
    document.getElementById('helpdeskModalTitle').innerText = '시스템 요청 작성';
}

function closeHelpdeskWriteModal() {
    document.getElementById('helpdeskWriteModal').classList.add('hidden');
}

async function openEditHelpdeskModal(id) {
    const list = await loadHelpdeskList();
    const item = list.find(i => i.id === id);
    if (!item) return;

    document.getElementById('helpdeskWriteModal').classList.remove('hidden');
    document.getElementById('helpdesk-id').value = item.id;
    document.getElementById('helpdesk-firestore-id').value = item.firestoreId || '';
    document.getElementById('helpdesk-author').value = item.author;
    document.getElementById('helpdesk-facility').value = item.facility;
    document.getElementById('helpdesk-category').value = item.category;
    document.getElementById('helpdesk-content').value = item.content;
    document.getElementById('helpdesk-status').value = item.status || 'received';
    document.getElementById('helpdesk-response').value = item.adminResponse || '';
    document.getElementById('helpdeskModalTitle').innerText = '시스템 요청 수정';
}

// Auth wrappers
function tryOpenHelpdeskWriteModal() {
    if (window.isAdminAuthenticated) {
        openHelpdeskWriteModal();
    } else {
        window.pendingAction = 'helpdesk_write';
        window.showAdminAuthModal();
    }
}

function tryEditHelpdesk(id) {
    if (window.isAdminAuthenticated) {
        openEditHelpdeskModal(id);
    } else {
        window.pendingAction = 'helpdesk_edit';
        window.pendingTargetId = id;
        window.showAdminAuthModal();
    }
}

function tryDeleteHelpdesk(id) {
    if (window.isAdminAuthenticated) {
        window.showConfirmModal('정말로 삭제하시겠습니까?', async () => {
            try {
                const list = await loadHelpdeskList();
                const item = list.find(i => i.id === id);
                
                if (window.db && item && item.firestoreId) {
                    await window.db.collection("system_requests").doc(item.firestoreId).delete();
                } else {
                    const newList = list.filter(i => i.id !== id);
                    saveHelpdeskList(newList);
                }
                
                renderHelpdeskList();
                
                const successMsg = document.createElement('div');
                successMsg.className = 'fixed bottom-4 right-4 bg-red-600 text-white px-6 py-3 rounded-lg shadow-lg z-50 animate-fade-in-up';
                successMsg.innerHTML = '<i data-lucide="check-circle" class="w-5 h-5 inline mr-2"></i> 삭제 완료';
                document.body.appendChild(successMsg);
                if(window.lucide) lucide.createIcons();
                setTimeout(() => successMsg.remove(), 2000);
                
            } catch (e) {
                console.error("Delete failed:", e);
                alert("삭제 실패: " + e.message);
            }
        });
    } else {
        window.pendingAction = 'helpdesk_delete';
        window.pendingTargetId = id;
        window.showAdminAuthModal();
    }
}

async function saveHelpdesk() {
    const id = document.getElementById('helpdesk-id').value;
    const firestoreId = document.getElementById('helpdesk-firestore-id').value;
    const author = document.getElementById('helpdesk-author').value;
    const facility = document.getElementById('helpdesk-facility').value;
    const category = document.getElementById('helpdesk-category').value;
    const content = document.getElementById('helpdesk-content').value;
    const status = document.getElementById('helpdesk-status').value;
    const adminResponse = document.getElementById('helpdesk-response').value;
    const date = new Date().toISOString().substring(0, 10);

    if (!author || !facility || !category || !content) {
        alert('작성자, 시설, 분야, 내용을 모두 입력해주세요.');
        return;
    }

    try {
        if (window.db) {
            // Firestore Save
            if (firestoreId) {
                // Update
                await withTimeout(
                    window.db.collection("system_requests").doc(firestoreId).update({
                        author, facility, category, content, status, adminResponse, date
                    })
                );
            } else {
                // Add
                const list = await loadHelpdeskList();
                const maxId = list.length > 0 ? Math.max(...list.map(i => i.id)) : 0;
                const newId = maxId + 1;
                
                await withTimeout(
                    window.db.collection("system_requests").add({
                        id: newId, author, facility, category, content, status, adminResponse, date
                    })
                );
            }
        } else {
            // LocalStorage fallback
            const list = await loadHelpdeskList();
            if (id) {
                const index = list.findIndex(i => i.id === parseInt(id));
                if (index !== -1) {
                    list[index] = { ...list[index], author, facility, category, content, status, adminResponse, date };
                }
            } else {
                const maxId = list.length > 0 ? Math.max(...list.map(i => i.id)) : 0;
                list.unshift({ id: maxId + 1, author, facility, category, content, status, adminResponse, date });
            }
            saveHelpdeskList(list);
        }
        
        closeHelpdeskWriteModal();
        renderHelpdeskList();
        
        // Success feedback
        const successMsg = document.createElement('div');
        successMsg.className = 'fixed bottom-4 right-4 bg-green-600 text-white px-6 py-3 rounded-lg shadow-lg z-50 animate-fade-in-up';
        successMsg.innerHTML = '<i data-lucide="check-circle" class="w-5 h-5 inline mr-2"></i> 저장 완료';
        document.body.appendChild(successMsg);
        if(window.lucide) lucide.createIcons();
        setTimeout(() => successMsg.remove(), 2000);

    } catch (e) {
        console.error("Save failed:", e);
        alert("저장 실패: " + e.message);
    }
}

// Expose functions globally
window.loadHelpdeskList = loadHelpdeskList;
window.saveHelpdeskList = saveHelpdeskList;
window.renderHelpdeskList = renderHelpdeskList;
window.openHelpdeskWriteModal = openHelpdeskWriteModal;
window.openEditHelpdeskModal = openEditHelpdeskModal;
window.closeHelpdeskWriteModal = closeHelpdeskWriteModal;
window.saveHelpdesk = saveHelpdesk;
window.tryOpenHelpdeskWriteModal = tryOpenHelpdeskWriteModal;
window.tryEditHelpdesk = tryEditHelpdesk;
window.tryDeleteHelpdesk = tryDeleteHelpdesk;
