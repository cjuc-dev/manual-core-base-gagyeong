{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run File Notes (from MANUAL-8)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/file-notes-ext"],
      "outFiles": ["${workspaceFolder}/file-notes-ext/**/*.js"]
    }
  ]
}
